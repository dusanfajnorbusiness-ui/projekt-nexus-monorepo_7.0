{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/main-web/dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "uplink.projekt-nexus.sk"
        }
      ],
      "destination": "https://projekt-nexus.sk/login",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "shop.projekt-nexus.sk"
        }
      ],
      "destination": "https://projekt-nexus.sk/shop/:path*",
      "permanent": true
    },
