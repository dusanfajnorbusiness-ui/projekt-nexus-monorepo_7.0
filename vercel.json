    { "source": "/:path*", "has": [{ "type": "host", "value": "codex.projekt-nexus.sk" }], "destination": "/sub-12/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "habits.projekt-nexus.sk" }], "destination": "/sub-13/:path*" },
