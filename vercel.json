    { "source": "/:path*", "has": [{ "type": "host", "value": "study.projekt-nexus.sk" }], "destination": "/sub-06/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "professional.projekt-nexus.sk" }], "destination": "/sub-07/:path*" },
