{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/main-web/dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "uplink.projekt-nexus.sk" }],
      "destination": "/uplink/:path*"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "agency.projekt-nexus.sk" }],
      "destination": "/agency/:path*"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "shop.projekt-nexus.sk" }],
      "destination": "/shop/:path*"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "admin.projekt-nexus.sk" }],
      "destination": "/admin/:path*"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "blog.projekt-nexus.sk" }],
      "destination": "/blog/:path*"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "operators.projekt-nexus.sk" }],
      "destination": "/operators/:path*"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "settings.projekt-nexus.sk" }],
      "destination": "/settings/:path*"
    },
    { "source": "/agency/:path*", "destination": "/agency/index.html" },
    { "source": "/shop/:path*", "destination": "/shop/index.html" },
    { "source": "/admin/:path*", "destination": "/admin/index.html" },
    { "source": "/blog/:path*", "destination": "/blog/index.html" },
    { "source": "/operators/:path*", "destination": "/operators/index.html" },
    { "source": "/settings/:path*", "destination": "/settings/index.html" },
    { "source": "/uplink/:path*", "destination": "/uplink/index.html" },
    { "source": "/login", "destination": "/uplink/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}