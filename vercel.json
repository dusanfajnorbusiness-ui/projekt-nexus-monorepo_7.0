{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/main-web/dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "shop.projekt-nexus.sk" }], "destination": "/shop/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "agency.projekt-nexus.sk" }], "destination": "/agency/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "admin.projekt-nexus.sk" }], "destination": "/admin/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "operators.projekt-nexus.sk" }], "destination": "/operators/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "settings.projekt-nexus.sk" }], "destination": "/settings/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "mentor.projekt-nexus.sk" }], "destination": "/subdomeny/mentor/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "personal.projekt-nexus.sk" }], "destination": "/subdomeny/personal/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "work.projekt-nexus.sk" }], "destination": "/subdomeny/work/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "finance.projekt-nexus.sk" }], "destination": "/subdomeny/finance/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "business.projekt-nexus.sk" }], "destination": "/subdomeny/business/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "investments.projekt-nexus.sk" }], "destination": "/subdomeny/investments/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "study.projekt-nexus.sk" }], "destination": "/subdomeny/study/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "professional.projekt-nexus.sk" }], "destination": "/subdomeny/professional/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "reader.projekt-nexus.sk" }], "destination": "/subdomeny/reader/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "player.projekt-nexus.sk" }], "destination": "/subdomeny/player/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "home.projekt-nexus.sk" }], "destination": "/subdomeny/home/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "recovery.projekt-nexus.sk" }], "destination": "/subdomeny/recovery/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "codex.projekt-nexus.sk" }], "destination": "/subdomeny/codex/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "habits.projekt-nexus.sk" }], "destination": "/subdomeny/habits/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "blog.projekt-nexus.sk" }], "destination": "/blog/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "death.projekt-nexus.sk" }], "destination": "/subdomeny/death/:path*" },
    { "source": "/agency/:path*", "destination": "/agency/index.html" },
    { "source": "/shop/:path*", "destination": "/shop/index.html" },
    { "source": "/admin/:path*", "destination": "/admin/index.html" },
    { "source": "/blog/:path*", "destination": "/blog/index.html" },
    { "source": "/operators/:path*", "destination": "/operators/index.html" },
    { "source": "/settings/:path*", "destination": "/settings/index.html" },
    { "source": "/subdomeny/:path*", "destination": "/subdomeny/index.html" },
    { "source": "/uplink/:path*", "destination": "/uplink/index.html" },
    { "source": "/login", "destination": "/uplink/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}