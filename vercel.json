    { "source": "/:path*", "has": [{ "type": "host", "value": "settings.projekt-nexus.sk" }], "destination": "/settings/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "blog.projekt-nexus.sk" }], "destination": "/blog/:path*" },

    { "source": "/:path*", "has": [{ "type": "host", "value": "mentor.projekt-nexus.sk" }], "destination": "/sub-00/:path*" },
