{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": {
      "@shared/*": ["./shared/src/*"],
      "@main-web/*": ["./apps/main-web/src/*"],
      "@shop/*": ["./apps/shop/src/*"],
      "@agency/*": ["./apps/agency/src/*"],
      "@uplink/*": ["./apps/uplink/src/*"],
      "@operators/*": ["./apps/operators/src/*"],
      "@admin/*": ["./apps/admin/src/*"],
      "@settings/*": ["./apps/settings/src/*"],
      "@blog/*": ["./apps/blog/src/*"],
      "@subdomeny/*": ["./apps/subdomeny/src/*"]
    }
  },
  "exclude": ["node_modules", "**/dist"]
}
