{
  "name": "@nexus/agency",
  "private": true,
  "version": "20.95.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"const fs=require('fs'); fs.existsSync('dist') && fs.rmSync('dist', {recursive:true, force:true});\"",
    "snap": "node -e \"const fs=require('fs'); if(fs.existsSync('./scripts/prerender-seo.mjs')) require('./scripts/prerender-seo.mjs'); else console.log('⚠️ [SEO SNAPSHOT]: prerender skript nenájdený, presakujem.');\"",
    "build": "npm run clean && vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "vite": "^5.1.6"
  }
}
